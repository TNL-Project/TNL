#!/usr/bin/env bash

# Uncomment if you want to exit as soon as there is an error
# set -o errexit

# abort when an unset variable is used
set -o nounset
# enable recursive globbing
shopt -s globstar

graphs_base_path="./"
input_files="input-files"
OMP_ENABLED="yes"
MAX_OMP_THREADS="auto"
DEBUG="no"
SIZE_LIMIT=-1 # no size limit
PRECISION="double"
log_file="graphs-benchmark.log"
progress_dir="progress"
continue_benchmark="no"
MPI_ENABLED="no"
MPI_PROCESSES=1
MPI_EXTRA_ARGS=""
MAX_CONSECUTIVE_FAILURES=3
BENCHMARK_ARGS=()

# Loop through all the positional arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -b|--benchmark)  # Binary to benchmark
            BENCHMARK="$2"
            shift  # Move past the value to the next key
            ;;
        -i|--input-dir)  # Input directory
            graphs_base_path="$2"
            shift
            ;;
        -I|--input-files)  # Input file containing list of graphs to benchmark
            input_files="$2"
            shift
            ;;
        -l|--log-file)  # Log file
            log_file="$2"
            shift
            ;;
        -g|--progress-dir)  # Directory for the per-graph progress files
            progress_dir="$2"
            shift
            ;;
        -c|--continue)  # Continue from a previous run
            continue_benchmark="$2"
            shift
            ;;
        -s|--size-limit)  # Size limit for input file
            SIZE_LIMIT="$2"
            shift
            ;;
        -d|--debug)  # Debug mode
            DEBUG="$2"
            shift
            ;;
        -o|--openmp-enabled)  # Enable OpenMP
            OMP_ENABLED="$2"
            shift
            ;;
        -t|--openmp-max-threads)  # Maximum number of OpenMP threads
            MAX_OMP_THREADS="$2"
            shift
            ;;
        -m|--mpi-enabled)  # Enable MPI
            MPI_ENABLED="$2"
            shift
            ;;
        -p|--mpi-processes)  # Number of MPI processes
            MPI_PROCESSES="$2"
            shift
            ;;
        -e|--mpi-extra-args)  # Extra arguments passed to mpirun, before -np
            MPI_EXTRA_ARGS="$2"
            shift
            ;;
        -r|--precision) # Arithmetical precision
            PRECISION="$2"
            shift
            ;;
        --max-consecutive-failures)  # Give up on a graph after this many crashes with no progress
            MAX_CONSECUTIVE_FAILURES="$2"
            shift
            ;;
        --)  # The remaining arguments are passed to the benchmark binary
            shift
            BENCHMARK_ARGS=("$@")
            break
            ;;
        -h|--help)  # Display help
            echo "Usage: $0 [options] [-- BENCHMARK_ARGS...]"
            echo "Options:"
            echo "  -b, --benchmark BINARY        Binary to benchmark"
            echo "  -i, --input-dir DIR           Input directory. Default: ./"
            echo "  -I, --input-files FILE        Input file containing list of graphs to benchmark. Default: input-files (created if not exists)"
            echo "  -l, --log-file FILE           Log file. Default: graphs-benchmark.log"
            echo "  -g, --progress-dir DIR        Directory for the per-graph progress files. Default: progress"
            echo "  -c, --continue yes/no         Continue from a previous run. Default: no"
            echo "  -s, --size-limit SIZE         Size limit for input files, -1 for no limit. Default: -1"
            echo "  -d, --debug  yes/no           Debug mode. Default: no"
            echo "  -o, --openmp-enabled yes/no   Enable OpenMP. Default: yes"
            echo "  -t, --openmp-max-threads MAX  Maximum number of OpenMP threads. Default: auto"
            echo "  -m, --mpi-enabled yes/no      Run the benchmark via mpirun. Default: no"
            echo "  -p, --mpi-processes NUM       Number of MPI processes (mpirun -np). Default: 1"
            echo "  -e, --mpi-extra-args STRING   Extra mpirun arguments, inserted before -np. Default: (none)"
            echo "  -r, --precision               Arithmetical precision - float or double. Default: double"
            echo "      --max-consecutive-failures NUM"
            echo "                                Give up on (and skip) a graph after this many consecutive"
            echo "                                crashes with no progress recorded for it. Default: 3"
            echo "  -h, --help                    Display help"
            echo "Arguments after -- are passed to the benchmark binary, e.g. -- --device cuda --trials 8."
            exit 0
            ;;
        *)  # Handle unknown options
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
    shift  # Move to the next key or value
done


if [[ ! -d "$graphs_base_path" ]]; then
    echo "The path '$graphs_base_path' does not exist." >&2
    exit 1
fi

if [[ ! -d "$(dirname "$log_file")" ]]; then
    mkdir -p "$(dirname "$log_file")"
fi

if [[ -f "$log_file" ]] && [[ "$continue_benchmark" != "yes" ]]; then
    echo "WARNING: deleting an existing log file $log_file."
    rm -f "$log_file"
fi

if [[ -f "$input_files" ]] && [[ "$continue_benchmark" != "yes" ]]; then
    echo "WARNING: deleting an existing list of input files."
    rm -f "$input_files"
fi

if [[ ! -f "$input_files" ]]; then
   echo "Creating list of input files..."
   touch "$input_files"
   for file in "$graphs_base_path"/**/*.mtx; do
      file_size=$(stat --format="%s" "$file")
      if [[ $SIZE_LIMIT -eq -1 ]] || [[ $file_size -lt $SIZE_LIMIT ]]; then
         echo "$file"
         echo "$file" >> "$input_files"
      else
         echo "Graph $file is too large - SKIPPING."
      fi
   done
fi

# set the default number of OpenMP threads to the number of CPU cores
if [[ "$MAX_OMP_THREADS" == "auto" ]]; then
    if [[ $(command -v lscpu) ]]; then
        # get the number of physical cores present on the system, even with multiple NUMA nodes
        # see https://unix.stackexchange.com/a/279354
        MAX_OMP_THREADS=$(lscpu --all --parse=CORE,SOCKET | grep -Ev "^#" | sort -u | wc -l)
    elif [[ $(command -v sysctl) && $OSTYPE == 'darwin'* ]]; then
        # get the number of physical cores present on the system for MacOS
        MAX_OMP_THREADS=$(sysctl -n hw.ncpu)
    fi
fi

# set parameters for the benchmark
COMMAND=()
if [[ "$MPI_ENABLED" == "yes" ]]; then
    COMMAND+=(mpirun)
    # mpirun binds each process to one core by default (Open MPI does so for
    # up to two processes), so all OpenMP threads of the process would share
    # this core
    if [[ "$OMP_ENABLED" == "yes" && "$MPI_EXTRA_ARGS" != *bind-to* ]]; then
        COMMAND+=(--bind-to none)
    fi
    if [[ -n "$MPI_EXTRA_ARGS" ]]; then
        # split the extra arguments on whitespace
        read -r -a mpi_extra_args <<< "$MPI_EXTRA_ARGS"
        COMMAND+=("${mpi_extra_args[@]}")
    fi
    COMMAND+=(-np "$MPI_PROCESSES")
fi
COMMAND+=("$BENCHMARK" --precision "$PRECISION" --log-file "$log_file" --output-mode append --verbose 1)
COMMAND+=(--graph-list "$input_files" --graph-list-base-path "$graphs_base_path" --progress-dir "$progress_dir")
COMMAND+=("${BENCHMARK_ARGS[@]}")

if [[ "$OMP_ENABLED" == "yes" ]]; then
    COMMAND+=(--openmp-enabled yes)
    if [[ $MAX_OMP_THREADS != "" ]]; then
        COMMAND+=(--openmp-max-threads "$MAX_OMP_THREADS")
    fi
else
    COMMAND+=(--openmp-enabled no)
fi

# The binary now manages the whole list itself in one process (see --graph-list above), removing
# each graph only once it is fully benchmarked - a crash (e.g. a segfault) leaves it at the head
# of the list, so simply re-running the same command resumes from there, continuing mid-graph via
# its progress file. This loop only matters when that happens: the common case is a single pass
# through it. consecutive_failures guards against spinning forever on one graph that crashes
# before ever recording any progress for itself.
consecutive_failures=0
while [[ -s "$input_files" ]]; do
   before_count=$(wc -l < "$input_files")
   head_graph=$(head -n 1 "$input_files")

   echo "${COMMAND[@]}"
   if [[ "$DEBUG" == "yes" ]]; then
      gdb --args "${COMMAND[@]}"
      status=$?
   else
      "${COMMAND[@]}"
      status=$?
   fi
   if [ $status -eq 139 ]; then
      echo "Caught segfault, but continuing script execution."
      touch segfaults.log
      echo "${COMMAND[@]}" >> segfaults.log
   fi
   rm -f core*

   if [[ ! -s "$input_files" ]]; then
      break
   fi
   after_count=$(wc -l < "$input_files")
   after_head=$(head -n 1 "$input_files")
   if [[ "$after_count" -lt "$before_count" || "$after_head" != "$head_graph" ]]; then
      # at least one graph got fully processed since the last attempt
      consecutive_failures=0
   else
      consecutive_failures=$((consecutive_failures + 1))
      echo "No progress on graph $head_graph after exit status $status (consecutive failures: $consecutive_failures)"
      if [[ $consecutive_failures -ge $MAX_CONSECUTIVE_FAILURES ]]; then
         echo "WARNING: giving up on $head_graph after $consecutive_failures consecutive failures with no progress - skipping it."
         touch failed-graphs.txt
         echo "$head_graph" >> failed-graphs.txt
         sed -i.bak '1d' "$input_files" && rm -f "$input_files.bak"
         consecutive_failures=0
      fi
   fi
done
rm -f "$input_files"
