#!/bin/bash

# Runs the 3D heat equation benchmark for all implementations, schemes, precisions and devices.
# The devices can be set by the environment variable DEVICES, e.g. DEVICES="host cuda".
# The benchmark reports the implementations of the comparison libraries which were not built.

set -u

devices="${DEVICES:-sequential host cuda}"
precisions="float double"
schemes="fdm fvm"
implementations="parallel-for nd-array grid kokkos amrex gridtools"
min_x_dimension="50"
min_y_dimension="50"
min_z_dimension="50"
max_x_dimension="200"
max_y_dimension="200"
max_z_dimension="200"
base="tnl-benchmark-heat-equation"

for device in ${devices}; do
   # the GPU benchmarks are separate executables
   case "${device}" in
      cuda | hip) solver="${base}-${device}" ;;
      *) solver="${base}" ;;
   esac
   for precision in ${precisions}; do
      for scheme in ${schemes}; do
         for implementation in ${implementations}; do
            # the NDArray implementation supports only the finite difference scheme
            if [[ "${implementation}" == "nd-array" && "${scheme}" == "fvm" ]]; then
               continue
            fi
            command=(
               "${solver}"
               --implementation "${implementation}"
               --precision "${precision}"
               --scheme "${scheme}"
               --dimension 3
               --min-x-dimension "${min_x_dimension}"
               --min-y-dimension "${min_y_dimension}"
               --min-z-dimension "${min_z_dimension}"
               --max-x-dimension "${max_x_dimension}"
               --max-y-dimension "${max_y_dimension}"
               --max-z-dimension "${max_z_dimension}"
               --max-iterations 100
               --loops 10
               --final-time 0.1
               --device "${device}"
               --log-file "${base}-${implementation}-${device}-${precision}-${scheme}-3d.json"
               --write-data no
            )
            echo "${command[@]}"
            "${command[@]}"
         done
      done
   done
done
