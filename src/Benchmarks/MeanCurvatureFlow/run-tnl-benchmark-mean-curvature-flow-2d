#!/bin/bash

# Runs the 2D mean curvature flow benchmark for all implementations, precisions and devices.
# The devices can be set by the environment variable DEVICES, e.g. DEVICES="host cuda".
# The benchmark reports the implementations of the comparison libraries which were not built.

set -u

devices="${DEVICES:-sequential host cuda}"
precisions="float double"
schemes="fdm"
implementations="parallel-for grid kokkos amrex gridtools"
min_x_dimension="50"
min_y_dimension="50"
max_x_dimension="800"
max_y_dimension="800"
base="tnl-benchmark-mean-curvature-flow"

for device in ${devices}; do
   # the GPU benchmarks are separate executables
   case "${device}" in
      cuda | hip) solver="${base}-${device}" ;;
      *) solver="${base}" ;;
   esac
   for precision in ${precisions}; do
      for scheme in ${schemes}; do
         for implementation in ${implementations}; do
            command=(
               "${solver}"
               --implementation "${implementation}"
               --precision "${precision}"
               --scheme "${scheme}"
               --dimension 2
               --min-x-dimension "${min_x_dimension}"
               --min-y-dimension "${min_y_dimension}"
               --max-x-dimension "${max_x_dimension}"
               --max-y-dimension "${max_y_dimension}"
               --max-iterations 500
               --loops 25
               --final-time 0.1
               --device "${device}"
               --log-file "${base}-${implementation}-${device}-${precision}-${scheme}-2d.json"
               --write-data no
            )
            echo "${command[@]}"
            "${command[@]}"
         done
      done
   done
done
