# Functions for building executables from one source for several backends.
#
# The sources of examples, tests and benchmarks are written once and compiled
# by the host compiler, by the CUDA compiler and by the HIP compiler. Instead of
# keeping one source file (or a symbolic link) for each backend in the source
# tree, the source files for the backends which cannot compile the given source
# directly are generated in the build directory. The generated file contains
# only #include directives of the given sources.

# Generate the source file of an executable for one backend.
#
# usage: tnl_get_backend_source(<output_variable>
#           TARGET <target>
#           BACKEND <HOST|CUDA|HIP>
#           SOURCES <source>...)
#
# The variable <output_variable> is set to the source file which is compiled
# for the given backend:
# - when there is only one source with the extension of the backend (.cpp,
#   .cu, .hip), it is returned directly,
# - otherwise the file <build_dir>/generated/<target><extension> is generated
#   with file(CONFIGURE) and it #includes all the given sources. The file is
#   rewritten only when its content changes, so the target is not rebuilt after
#   each configuration.
function(tnl_get_backend_source output_variable)
    set(options)
    set(oneValueArgs TARGET BACKEND)
    set(multiValueArgs SOURCES)
    cmake_parse_arguments(ARG "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "tnl_get_backend_source: unknown arguments: ${ARG_UNPARSED_ARGUMENTS}")
    endif()

    if(NOT ARG_TARGET)
        message(FATAL_ERROR "tnl_get_backend_source: TARGET is not set")
    endif()
    if(NOT ARG_SOURCES)
        message(FATAL_ERROR "tnl_get_backend_source: SOURCES are not set for target '${ARG_TARGET}'")
    endif()

    if(ARG_BACKEND STREQUAL "HOST")
        set(extension ".cpp")
    elseif(ARG_BACKEND STREQUAL "CUDA")
        set(extension ".cu")
    elseif(ARG_BACKEND STREQUAL "HIP")
        set(extension ".hip")
    else()
        message(FATAL_ERROR "tnl_get_backend_source: unknown backend '${ARG_BACKEND}' for target '${ARG_TARGET}'")
    endif()

    list(LENGTH ARG_SOURCES sources_count)
    if(sources_count EQUAL 1)
        get_filename_component(source_extension "${ARG_SOURCES}" LAST_EXT)
        if(source_extension STREQUAL extension)
            set(${output_variable} "${ARG_SOURCES}" PARENT_SCOPE)
            return()
        endif()
    endif()

    set(content "// Generated by CMake for the target ${ARG_TARGET}, do not edit.\n")
    foreach(source IN LISTS ARG_SOURCES)
        get_filename_component(source_path "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${source_path}")
            message(FATAL_ERROR "tnl_get_backend_source: source '${source}' of target '${ARG_TARGET}' does not exist")
        endif()
        string(APPEND content "#include \"${source_path}\"\n")
    endforeach()

    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/${ARG_TARGET}${extension}")
    file(CONFIGURE OUTPUT "${generated}" CONTENT "${content}" @ONLY)
    set(${output_variable} "${generated}" PARENT_SCOPE)
endfunction()

# Add executables built from the same sources for several backends.
#
# usage:
#   tnl_add_backend_executables(<name>
#       SOURCES <source>...
#       [CUDA_SOURCES <source>...] [HIP_SOURCES <source>...]
#       [BACKENDS <backend>...] [SINGLE] [OPTIONAL_HOST]
#       [COMPILE_DEFINITIONS <definition>...]
#       [LINK_LIBRARIES <library>...]
#       [CUDA_LINK_LIBRARIES <library>...] [HIP_LINK_LIBRARIES <library>...]
#       [OUTPUT_TARGETS <variable>] [OUTPUT_BACKENDS <variable>])
#
# - SOURCES are the sources for all backends, typically one header file (e.g. a
#   unit test) or one source file (e.g. an example). See tnl_get_backend_source.
#   CUDA_SOURCES and HIP_SOURCES replace SOURCES for one backend when the
#   sources really differ between backends.
# - BACKENDS is the list of backends (HOST, CUDA, HIP) for which the
#   executables are built (default: all backends with sources). A backend is
#   skipped when it is not enabled (TNL_BUILD_CUDA, TNL_BUILD_HIP).
# - The host executable is named <name>, the CUDA and HIP executables are named
#   <name>-cuda and <name>-hip.
# - SINGLE builds only one executable named <name> for the first enabled
#   backend in BACKENDS. For example, BACKENDS CUDA HIP HOST SINGLE builds the
#   CUDA executable if CUDA is enabled, otherwise the HIP or the host executable.
# - OPTIONAL_HOST skips the host executable when TNL_BUILD_CPP_TARGETS is false
#   (in GPU jobs in the CI).
# - All executables are linked with TNL::TNL.
# - OUTPUT_TARGETS and OUTPUT_BACKENDS are set to the lists of the added targets
#   and their backends.
#
# Typical usages:
#
#   # one executable for each enabled backend: foo, foo-cuda, foo-hip
#   tnl_add_backend_executables(foo SOURCES foo.h)
#
#   # host-only executable
#   tnl_add_backend_executables(foo SOURCES foo.cpp BACKENDS HOST)
#
#   # one executable for the best enabled backend
#   tnl_add_backend_executables(foo SOURCES foo.h BACKENDS CUDA HIP HOST SINGLE)
#
#   # host executable skipped in GPU jobs in the CI
#   tnl_add_backend_executables(foo SOURCES foo.h OPTIONAL_HOST)
function(tnl_add_backend_executables name)
    set(options SINGLE OPTIONAL_HOST)
    set(oneValueArgs OUTPUT_TARGETS OUTPUT_BACKENDS)
    set(multiValueArgs
        SOURCES
        CUDA_SOURCES
        HIP_SOURCES
        BACKENDS
        COMPILE_DEFINITIONS
        LINK_LIBRARIES
        CUDA_LINK_LIBRARIES
        HIP_LINK_LIBRARIES
    )
    cmake_parse_arguments(ARG "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "tnl_add_backend_executables: unknown arguments for '${name}': ${ARG_UNPARSED_ARGUMENTS}")
    endif()

    foreach(backend IN ITEMS HOST CUDA HIP)
        if(NOT ARG_${backend}_SOURCES)
            set(ARG_${backend}_SOURCES ${ARG_SOURCES})
        endif()
    endforeach()
    if(NOT ARG_BACKENDS)
        foreach(backend IN ITEMS HOST CUDA HIP)
            if(ARG_${backend}_SOURCES)
                list(APPEND ARG_BACKENDS ${backend})
            endif()
        endforeach()
    endif()
    set(enabled_HOST TRUE)
    if(ARG_OPTIONAL_HOST AND NOT TNL_BUILD_CPP_TARGETS)
        set(enabled_HOST FALSE)
    endif()
    set(enabled_CUDA ${TNL_BUILD_CUDA})
    set(enabled_HIP ${TNL_BUILD_HIP})

    set(targets)
    set(backends)
    foreach(backend IN LISTS ARG_BACKENDS)
        if(NOT backend MATCHES "^(HOST|CUDA|HIP)$")
            message(FATAL_ERROR "tnl_add_backend_executables: unknown backend '${backend}' for '${name}'")
        endif()
        if(NOT enabled_${backend})
            continue()
        endif()
        if(NOT ARG_${backend}_SOURCES)
            message(FATAL_ERROR "tnl_add_backend_executables: no sources for backend ${backend} of '${name}'")
        endif()

        if(ARG_SINGLE OR backend STREQUAL "HOST")
            set(target ${name})
        else()
            string(TOLOWER ${backend} suffix)
            set(target ${name}-${suffix})
        endif()

        tnl_get_backend_source(source TARGET ${target} BACKEND ${backend} SOURCES ${ARG_${backend}_SOURCES})
        add_executable(${target} ${source})
        target_link_libraries(${target} PUBLIC TNL::TNL ${ARG_LINK_LIBRARIES} ${ARG_${backend}_LINK_LIBRARIES})
        if(ARG_COMPILE_DEFINITIONS)
            target_compile_definitions(${target} PUBLIC ${ARG_COMPILE_DEFINITIONS})
        endif()

        list(APPEND targets ${target})
        list(APPEND backends ${backend})
        if(ARG_SINGLE)
            break()
        endif()
    endforeach()

    if(ARG_OUTPUT_TARGETS)
        set(${ARG_OUTPUT_TARGETS} ${targets} PARENT_SCOPE)
    endif()
    if(ARG_OUTPUT_BACKENDS)
        set(${ARG_OUTPUT_BACKENDS} ${backends} PARENT_SCOPE)
    endif()
endfunction()

# Add a documentation example and a custom command which runs it and stores
# its output in the documentation snippets directory.
#
# usage:
#   tnl_add_example_with_output(<name>
#       SOURCES <source>...
#       [CUDA_SOURCES <source>...]
#       [BACKENDS <backend>...]
#       [ARGS <arg>...]
#       [MPI [NPROC <nproc>]])
#
# - the executable is added with tnl_add_backend_executables with SINGLE, so
#   at most one executable named <name> is built; BACKENDS defaults to
#   CUDA HIP HOST
# - the example is executed with the given ARGS and its output is stored in
#   ${TNL_DOCUMENTATION_OUTPUT_SNIPPETS_PATH}/<name>.out
# - MPI enables MPI support (like in tnl_add_test_executables) and runs the
#   example with MPIEXEC_EXECUTABLE using NPROC processes (default: 4); the
#   example is skipped when TNL_BUILD_MPI is false
# - the output file is registered as a dependency of the run-doc-examples
#   target (see Documentation/CMakeLists.txt)
function(tnl_add_example_with_output name)
    set(options MPI)
    set(oneValueArgs NPROC)
    set(multiValueArgs SOURCES CUDA_SOURCES BACKENDS ARGS)
    cmake_parse_arguments(ARG "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "tnl_add_example_with_output: unknown arguments for '${name}': ${ARG_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT ARG_SOURCES)
        message(FATAL_ERROR "tnl_add_example_with_output: SOURCES are not set for '${name}'")
    endif()
    if(ARG_MPI AND NOT TNL_BUILD_MPI)
        return()
    endif()

    if(NOT ARG_BACKENDS)
        set(ARG_BACKENDS CUDA HIP HOST)
    endif()

    set(definitions)
    set(libraries)
    if(ARG_MPI)
        if(NOT ARG_NPROC)
            set(ARG_NPROC 4)
        endif()
        # enable MPI support in TNL
        set(definitions HAVE_MPI)
        # add MPI to the target: https://cliutils.gitlab.io/modern-cmake/chapters/packages/MPI.html
        set(libraries MPI::MPI_CXX)
    endif()

    tnl_add_backend_executables(
        ${name}
        SOURCES ${ARG_SOURCES}
        CUDA_SOURCES ${ARG_CUDA_SOURCES}
        BACKENDS ${ARG_BACKENDS}
        SINGLE
        COMPILE_DEFINITIONS ${definitions}
        LINK_LIBRARIES ${libraries}
    )

    # all requested backends may be disabled
    if(NOT TARGET ${name})
        return()
    endif()

    set(output "${TNL_DOCUMENTATION_OUTPUT_SNIPPETS_PATH}/${name}.out")
    set(executable "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/${name}${CMAKE_EXECUTABLE_SUFFIX}")
    if(ARG_MPI)
        set(mpiexec_parameters ${MPIEXEC_NUMPROC_FLAG} ${ARG_NPROC} --oversubscribe)
        add_custom_command(
            OUTPUT ${output}
            COMMAND "${MPIEXEC_EXECUTABLE}" ${mpiexec_parameters} "${executable}" ${ARG_ARGS} > ${output}
            DEPENDS ${name}
        )
    else()
        add_custom_command(OUTPUT ${output} COMMAND "${executable}" ${ARG_ARGS} > ${output} DEPENDS ${name})
    endif()
    # make the run-doc-examples target depend on the output; the target-level
    # dependency is needed because the custom command is defined in a
    # different directory than the run-doc-examples target
    add_custom_target(${name}.out DEPENDS ${output})
    add_dependencies(run-doc-examples ${name}.out)
endfunction()
